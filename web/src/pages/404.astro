---
/* The page for an address that the site does not have (wrangler.jsonc, not_found_handling). */
import favicon from '../assets/favicon.png';
import '../styles/site.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/png" href={favicon.src} />
		<title>Inky: page not found</title>
	</head>
	<body class="bg-background min-h-dvh">
		<main class="mx-auto flex w-full max-w-2xl flex-col items-start gap-4 px-6 py-16 sm:py-24">
			<h1 class="font-serif text-3xl font-semibold tracking-tight">Page not found</h1>
			<p class="text-muted-foreground">This address has no page.</p>
			<a href="/" class="text-link font-medium underline-offset-4 hover:underline">
				Go to the download page
			</a>
		</main>
	</body>
</html>
