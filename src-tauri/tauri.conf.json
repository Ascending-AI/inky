{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inky",
  "version": "0.1.0",
  "identifier": "com.inky.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Inky",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*.[pP][nN][gG]",
          "$HOME/**/*.[jJ][pP][gG]",
          "$HOME/**/*.[jJ][pP][eE][gG]",
          "$HOME/**/*.[gG][iI][fF]",
          "$HOME/**/*.[wW][eE][bB][pP]",
          "$HOME/**/*.[sS][vV][gG]",
          "$HOME/**/*.[aA][vV][iI][fF]",
          "$HOME/**/*.[bB][mM][pP]",
          "$HOME/**/*.[hH][eE][iI][cC]"
        ]
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQkQ5Qzc3NjMyMjIwQzcKUldUSElDSmpkNXk5cmQ0VDNQUUZCbVhyMFdIY2g2cU82SmJNV1E2RXM4QUdyd0RlOXhOci9semQK",
      "endpoints": [
        "https://inky-downloads.ascending.ai/app/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["mmd"],
        "name": "Mermaid Diagram",
        "description": "Mermaid diagram",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "category": "Productivity",
    "shortDescription": "A pleasant markdown reader and editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
